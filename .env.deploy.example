# Copy this file to .env.deploy and fill in real values.
# .env.deploy is gitignored — it must never be committed.
#
# Loaded automatically by ./deploy.sh so you don't have to type deploy
# variables by hand every time. See scripts/set-deploy-env.sh for what
# each variable does.
#
# Note: gcloud run deploy only touches what you pass here (the image,
# region, auth flag). Any runtime env vars already configured on the
# Cloud Run service itself are left untouched and carry over automatically
# on every deploy — no need to redeclare them.

GCP_PROJECT=

# Optional (defaults shown are what set-deploy-env.sh would use anyway)
CLOUD_RUN_SERVICE=espacio-raku-website
CLOUD_RUN_REGION=us-central1
DOCKER_PLATFORM=linux/amd64
ALLOW_UNAUTHENTICATED=true
SITE_URL=https://espacio-raku.com

# Optional: pin an image tag instead of using the current git short SHA
TAG=
